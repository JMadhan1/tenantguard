# Copy to .env and fill in. NEVER commit the real .env.

# ---- AWS Bedrock (Claude on Bedrock) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
TENANTGUARD_MODEL=global.anthropic.claude-opus-4-6-v1
# TENANTGUARD_BACKEND=bedrock   # auto-detected when AWS keys are present

# ---- neatlogs SDK (sends traces; required for the hackathon) ----
NEATLOGS_API_KEY=

# ---- neatlogs REST API (optional: verify traces via scripts/neatlogs_check.py) ----
NEATLOGS_TOKEN=
NEATLOGS_PROJECT_ID=
